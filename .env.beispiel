# Kopieren nach .env (nicht einchecken) oder in Netlify unter
# Site configuration → Environment variables eintragen.

# Ziel-URL des Anfrage-Servers (POST, JSON). Leer = Formular zeigt den
# Vorschau-Hinweis mit Mail-Link statt zu senden.
PUBLIC_ANFRAGE_URL=

# 1 = Vorschau-Build: jede Seite bekommt noindex,nofollow und ein „Vorschau"-Band.
PUBLIC_VORSCHAU=
