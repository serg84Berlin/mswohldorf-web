---
import Basis from '../layouts/Basis.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import Zeitleiste from '../components/Zeitleiste.astro';
import GalerieRaster from '../components/GalerieRaster.astro';
import PresseFilm from '../components/PresseFilm.astro';
import Lightbox from '../components/Lightbox.astro';
import Welle from '../components/Welle.astro';
import Symbol from '../components/Symbol.astro';
import { ALTE_BILDER, KATALOG } from '../data/bilder';
import { FAKTEN, MEDIEN } from '../config';

// Steckbrief. Quellen: alte Website (AS) und die Presse-PDFs der alten Website (boote, Mai 2019; Umbauen + Modernisieren).
const steckbrief = [
  { titel: 'Baujahr', wert: `${FAKTEN.baujahr}` },
  { titel: 'Herkunft', wert: 'HADAG-Hafenfähre, Typ-III-Serie („600er“)' },
  { titel: 'Antrieb früher', wert: 'diesel-elektrisch (DES)' },
  { titel: 'Länge', wert: `${FAKTEN.laengeM} Meter` },
  { titel: 'Fahrgäste damals', wert: `bis zu ${FAKTEN.fahrgaesteFrueher} (Typ III)` },
  { titel: 'Umbau', wert: '2016–2017 in Finkenwerder' },
  { titel: 'Nutzfläche heute', wert: `${FAKTEN.nutzflaecheM2} m²` },
  { titel: 'Gäste heute', wert: `bis zu ${FAKTEN.maxGaeste}` },
];
const umbau = KATALOG.filter((f) => f.kategorie === 'umbau');
const ueberfahrt = KATALOG.filter((f) => f.kategorie === 'ueberfahrt');
---

<Basis
  titel="Geschichte der MS Wohldorf — Hamburger Hafenfähre von 1959"
  beschreibung="1959 als HADAG-Hafenfähre in Dienst gestellt, 2016 umgebaut, 2017 in den Sandtorhafen, heute auf der Süderelbe: die Geschichte der MS Wohldorf — mit Boris Herrmann, den Pfefferkörnern und vielen Fotos."
  bild={ALTE_BILDER.social}
  fussVon="var(--color-sand-hell)"
>
  <SeitenKopf
    eyebrow="Geschichte"
    titel="Eine Hamburger Hafenfähre mit zweitem Leben."
    lead={`${FAKTEN.baujahr} in Dienst gestellt, ${FAKTEN.umbau} umgebaut, ${FAKTEN.sandtorhafen} in den Sandtorhafen, heute auf der Süderelbe: die MS Wohldorf in acht Stationen.`}
    bild={ALTE_BILDER.social}
    bildAlt="Die MS Wohldorf im Sandtorhafen, dahinter die Elbphilharmonie."
    nach="var(--color-nacht)"
  />

  <Zeitleiste variante="lang" titelId="stationen-titel" />

  <Welle von="var(--color-nacht)" nach="var(--color-schaum)" />

  <section class="bg-schaum" aria-labelledby="steckbrief-titel">
    <div class="seite-breite grid gap-10 py-16 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:py-20">
      <div data-reveal="links">
        <p class="eyebrow">Steckbrief</p>
        <h2 id="steckbrief-titel" class="titel-mittel mt-4 text-tiefe">Ein „Linienbus ohne Räder“.</h2>
        <p class="lead mt-5 text-grau">
          So nannte man die Hafenfähren, die mit Fenstern rundum für den Panoramablick gebaut wurden. Heute ist die Wohldorf eines
          der letzten sichtbaren Zeitzeugnisse ihres Schiffstyps.
        </p>
        <a class="textlink mt-6 inline-flex items-center gap-1.5 font-semibold" href={MEDIEN.lebenslauf} target="_blank" rel="noopener">
          Lebenslauf der Wohldorf auf elbdampfer-hamburg.de <Symbol name="extern" class="size-4" /><span class="sr-only"> (neues Fenster)</span>
        </a>
      </div>
      <div data-reveal="rechts">
        <dl class="steckbrief">
          {
            steckbrief.map((s) => (
              <div>
                <dt>{s.titel}</dt>
                <dd>{s.wert}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 text-sm text-grau">Quellen: bisherige Website; „Alles unter einem Dach“, boote, Mai 2019; „Büro ahoi!“, Umbauen + Modernisieren.</p>
      </div>
    </div>
  </section>

  <section class="bg-schaum" aria-labelledby="umbau-titel">
    <div class="seite-breite pb-16 lg:pb-20">
      <h2 id="umbau-titel" class="titel-mittel text-tiefe" data-reveal>Der Umbau 2016</h2>
      <p class="mt-3 max-w-2xl text-grau" data-reveal>Aufgebockt auf der Werft: Rumpf, Propeller und Ruder.</p>
      <GalerieRaster fotos={umbau} class="mt-8" sammlung="umbau" />

      <h2 id="sandtorhafen-titel" class="titel-mittel mt-20 text-tiefe" data-reveal>Einzug in den Sandtorhafen, Mai 2017</h2>
      <p class="mt-3 max-w-2xl text-grau" data-reveal>Mit einem Schlepper längsseits über die Elbe, vorbei an der Elbphilharmonie in den Traditionsschiffhafen.</p>
      <GalerieRaster fotos={ueberfahrt} class="mt-8" sammlung="sandtorhafen" />
    </div>
  </section>

  <PresseFilm />

  <Welle von="var(--color-schaum)" nach="var(--color-sand-hell)" />

  <section class="bg-sand-hell" aria-labelledby="weiter-titel" data-anfrage-verbergen>
    <div class="seite-breite py-16 text-center lg:py-20" data-reveal>
      <h2 id="weiter-titel" class="titel-mittel text-tiefe">Schreiben Sie das nächste Kapitel mit.</h2>
      <p class="lead mx-auto mt-5 max-w-xl text-grau">Feiern, tagen, drehen oder lesen — an Bord einer Hamburger Hafenfähre von {FAKTEN.baujahr}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/anfrage/" class="knopf knopf-messing" data-magnet>Jetzt anfragen <Symbol name="pfeil" /></a>
        <a href="/#anlaesse" class="knopf knopf-geist text-tiefe">Anlässe ansehen</a>
      </div>
    </div>
  </section>

  <Lightbox />
</Basis>

<style>
  .bg-schaum {
    background: var(--color-schaum);
  }
  .bg-sand-hell {
    background: var(--color-sand-hell);
  }
  .text-tiefe {
    color: var(--color-tiefe);
  }
  .steckbrief {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .steckbrief > div {
    padding: 1rem 1.1rem;
    border-radius: 0.9rem;
    background: #fff;
    border: 1px solid rgb(11 26 42 / 0.07);
  }
  .steckbrief dt {
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-messing-dunkel);
  }
  .steckbrief dd {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--color-tiefe);
  }
</style>
