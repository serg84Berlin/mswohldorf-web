---
import Basis from '../layouts/Basis.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import Zeitleiste from '../components/Zeitleiste.astro';
import ZweiKlick from '../components/ZweiKlick.astro';
import Welle from '../components/Welle.astro';
import Symbol from '../components/Symbol.astro';
import { FOTO_DROHNE_2024, FOTO_SANDTORHAFEN_2017 } from '../data/bilder';
import { FAKTEN, MEDIEN } from '../config';

const poster = [FOTO_DROHNE_2024, FOTO_SANDTORHAFEN_2017];
---

<Basis
  titel="Geschichte der MS Wohldorf — Hamburger Hafenfähre von 1959"
  beschreibung="Gebaut 1959 als HADAG-Hafenfähre, 2016 umgebaut, 2017 im Sandtorhafen eingelaufen, Basislager für Boris Herrmann: die Geschichte der MS Wohldorf in Hamburg."
  bild={FOTO_SANDTORHAFEN_2017.bild}
  fussVon="var(--color-sand-hell)"
>
  <SeitenKopf
    eyebrow="Geschichte"
    titel="Eine Hamburger Hafenfähre mit zweitem Leben."
    lead={`Gebaut ${FAKTEN.baujahr} für die HADAG, ${FAKTEN.umbau} umgebaut, ${FAKTEN.sandtorhafen} im Sandtorhafen eingelaufen: die MS Wohldorf in sechs Stationen.`}
    bild={FOTO_SANDTORHAFEN_2017.bild}
    bildAlt={FOTO_SANDTORHAFEN_2017.alt}
    nach="var(--color-nacht)"
  />

  <Zeitleiste variante="lang" titelId="stationen-titel" />

  <Welle von="var(--color-nacht)" nach="var(--color-schaum)" />

  <section class="bg-schaum" aria-labelledby="film-titel">
    <div class="seite-breite py-16 lg:py-24">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Im Film</p>
        <h2 id="film-titel" class="titel-mittel mt-4 text-tiefe">Die Wohldorf in Bewegung.</h2>
        <p class="mt-5 text-grau">Die Videos werden erst nach Ihrem Klick von YouTube geladen (youtube-nocookie.com).</p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2" data-reveal-gruppe>
        {
          MEDIEN.videos.map((v, i) => (
            <div data-reveal>
              <ZweiKlick
                art="youtube"
                src={`https://www.youtube-nocookie.com/embed/${v.id}?autoplay=1&rel=0&modestbranding=1`}
                titel={v.titel}
                anbieter="YouTube"
                direkt={`https://www.youtube.com/watch?v=${v.id}`}
                poster={poster[i].bild}
              />
              <p class="mt-3 text-sm text-grau">
                „{v.titel}" · YouTube-Kanal {v.kanal}
              </p>
            </div>
          ))
        }
      </div>
      <a href={MEDIEN.malizia.url} target="_blank" rel="noopener" class="malizia mt-8" data-reveal>
        <Symbol name="play" class="size-6 shrink-0 text-petrol" />
        <span>
          <span class="block font-semibold text-tiefe">Basislager für Boris Herrmann</span>
          <span class="block text-sm text-grau">„{MEDIEN.malizia.titel}" — {MEDIEN.malizia.kanal} (YouTube, neues Fenster)</span>
        </span>
        <Symbol name="extern" class="ml-auto size-5 shrink-0 text-petrol" />
      </a>
    </div>
  </section>

  <Welle von="var(--color-schaum)" nach="var(--color-sand-hell)" />

  <section class="bg-sand-hell" aria-labelledby="weiter-titel" data-anfrage-verbergen>
    <div class="seite-breite py-16 text-center lg:py-20" data-reveal>
      <h2 id="weiter-titel" class="titel-mittel text-tiefe">Schreiben Sie das nächste Kapitel mit.</h2>
      <p class="lead mx-auto mt-5 max-w-xl text-grau">Feiern, tagen, drehen oder lesen — an Bord einer Hamburger Hafenfähre von {FAKTEN.baujahr}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/anfrage/" class="knopf knopf-messing" data-magnet>Jetzt anfragen <Symbol name="pfeil" /></a>
        <a href="/#anlaesse" class="knopf knopf-geist text-tiefe">Anlässe ansehen</a>
      </div>
    </div>
  </section>
</Basis>

<style>
  .bg-schaum {
    background: var(--color-schaum);
  }
  .bg-sand-hell {
    background: var(--color-sand-hell);
  }
  .text-tiefe {
    color: var(--color-tiefe);
  }
  .malizia {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.3rem;
    border-radius: 1.1rem;
    background: var(--color-sand-hell);
    border: 1px solid rgb(11 26 42 / 0.08);
    transition: border-color 0.2s;
  }
  .malizia:hover {
    border-color: var(--color-petrol);
  }
</style>
