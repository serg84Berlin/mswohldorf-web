---
/**
 * Impressum — wie das Impressum von finanzelot.de (Entscheidung Uli, Mail vom
 * 04.11.2026: „das Impressum kannst du von Finanzelot übernehmen“): Anbieter,
 * Vertretung, Kontakt, Registereintrag, USt-IdNr., Verantwortlich nach § 18 Abs. 2 MStV.
 * Bewusst NICHT übernommen: die Angaben zur Finanz- und Versicherungsvermittlung
 * (§§ 34d/f/i GewO, Aufsicht, Schlichtung, Berufshaftpflicht) — sie betreffen nicht das
 * Angebot dieser Website. Ergänzt: Streitschlichtung und Bildnachweis der alten Seite.
 * Die Haftungs- und Urheberrechtstexte der alten Seite entfallen (finanzelot.de hat keine).
 *
 * Rechtliche Lücken stünden hier als `<Platzhalter pflicht>` (Livegang-Sperre,
 * integrationen/livegang-sperre.mjs). Stand 04.11.2026: keine.
 */
import Basis from '../layouts/Basis.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import { BETREIBER, KONTAKT } from '../config';

const k = BETREIBER.komplementaerin;
---

<Basis titel="Impressum" beschreibung="Impressum der Website der MS Wohldorf — Anbieterkennzeichnung der Finanzelot GmbH & Co. KG nach § 5 DDG." fussVon="var(--color-schaum)">
  <SeitenKopf eyebrow="Rechtliches" titel="Impressum" />
  <section class="bg-schaum">
    <div class="seite-breite fliesstext max-w-3xl py-12 lg:py-16">
      <h2>Angaben gemäß § 5 DDG</h2>

      <h3>Anbieter</h3>
      <p>
        {BETREIBER.firma}<br />
        {BETREIBER.strasse}, {BETREIBER.plz} {BETREIBER.ort}
      </p>

      <h3>Vertreten durch</h3>
      <p>
        Die persönlich haftende Gesellschafterin {k.firma}, {k.registergericht}, {k.register}, vertreten durch den Geschäftsführer
        {k.geschaeftsfuehrer}.
      </p>

      <h3>Kontakt</h3>
      <p>
        Telefon: <a href={`tel:${KONTAKT.telefonLink}`}>{KONTAKT.telefon}</a><br />
        Telefax: {KONTAKT.fax}<br />
        E-Mail: <a href={`mailto:${KONTAKT.mail}`}>{KONTAKT.mail}</a>
      </p>

      <h3>Registereintrag</h3>
      <p>Handelsregister: {BETREIBER.registergericht}, {BETREIBER.register}</p>

      <h3>Umsatzsteuer-Identifikationsnummer</h3>
      <p>USt-IdNr. nach § 27a UStG: {BETREIBER.ustId}</p>

      <h3>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h3>
      <p>{k.geschaeftsfuehrer}, Anschrift wie oben.</p>

      <h3>Streitschlichtung</h3>
      <p>Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>

      <h3>Bildnachweis</h3>
      <p>
        Fotos der Wohldorf: Andrea Klick. Standbilder aus den Videos „MS Wohldorf 2024“ (YouTube-Kanal Finanzelot) und „Einfahrt in den
        Sandtorhafen, Mai 2017" (YouTube-Kanal ulrichritter). Standbild „Die Pfefferkörner“: NDR. Kartenausschnitt: © OpenStreetMap-Mitwirkende,
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">ODbL</a>.
      </p>
    </div>
  </section>
</Basis>

<style>
  .bg-schaum {
    background: var(--color-schaum);
  }
</style>
