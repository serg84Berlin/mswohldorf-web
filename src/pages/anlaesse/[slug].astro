---
import type { GetStaticPaths } from 'astro';
import Basis from '../../layouts/Basis.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import AnlassKarten from '../../components/AnlassKarten.astro';
import GalerieRaster from '../../components/GalerieRaster.astro';
import Lightbox from '../../components/Lightbox.astro';
import Platzhalter from '../../components/Platzhalter.astro';
import Symbol from '../../components/Symbol.astro';
import Welle from '../../components/Welle.astro';
import { ANLAESSE, type Anlass } from '../../data/anlaesse';
import { fotosFuerAnlass, ANZAHL_UEBERNOMMEN } from '../../data/bilder';
import { SEITE } from '../../config';

export const getStaticPaths = (() => ANLAESSE.map((a) => ({ params: { slug: a.slug }, props: { anlass: a } }))) satisfies GetStaticPaths;

interface Props {
  anlass: Anlass;
}
const { anlass: a } = Astro.props;
const fotos = fotosFuerAnlass(a.slug, 6);
const symbole = ['personen', 'anker', 'wuerfel', 'karte'] as const;
const brotkrumen = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SEITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Anlässe', item: `${SEITE.url}/#anlaesse` },
    { '@type': 'ListItem', position: 3, name: a.kartenTitel, item: `${SEITE.url}/anlaesse/${a.slug}/` },
  ],
};
---

<Basis titel={a.seoTitel} beschreibung={a.seoBeschreibung} bild={fotos[0]?.bild} strukturiert={[brotkrumen]} fussVon="var(--color-sand-hell)">
  <SeitenKopf eyebrow={`Anlass · ${a.kartenTitel}`} titel={a.titel} lead={a.einleitung} bild={fotos[0]?.bild} bildAlt={fotos[0]?.alt}>
    <div class="mt-8 flex flex-wrap gap-3" data-reveal>
      <a href={`/anfrage/?anlass=${a.slug}`} class="knopf knopf-messing" data-magnet>Jetzt anfragen <Symbol name="pfeil" /></a>
      <a href="/#rundgang" class="knopf knopf-geist text-schaum"><Symbol name="wuerfel" /> 3D-Rundgang</a>
    </div>
  </SeitenKopf>

  <section class="bg-schaum" aria-labelledby="ueberblick-titel">
    <div class="seite-breite grid gap-12 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-20">
      <div data-reveal="links">
        <h2 id="ueberblick-titel" class="titel-mittel text-tiefe">Darum an Bord.</h2>
        <div class="lead mt-6 grid gap-4 text-grau">
          {a.absaetze.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2" data-reveal-gruppe>
        {
          a.vorteile.map((v, i) => (
            <li class="vorteil" data-reveal>
              <span class="vorteil-symbol">
                <Symbol name={symbole[i % symbole.length]} class="size-5" />
              </span>
              <h3 class="mt-4 text-lg leading-snug font-semibold text-tiefe">{v.titel}</h3>
              <p class="mt-1.5 text-grau">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-schaum" aria-labelledby="offen-titel">
    <div class="seite-breite pb-14 lg:pb-20">
      <div class="offen-kasten" data-reveal>
        <h2 id="offen-titel" class="font-display text-2xl text-tiefe">Gut zu wissen</h2>
        <p class="mt-2 text-grau">Diese Details klären wir gern persönlich mit Ihnen:</p>
        <ul class="mt-5 grid gap-3 md:grid-cols-2">
          {
            a.offen.map((o) => (
              <li>
                <Platzhalter class="text-tinte">{o}</Platzhalter>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Welle von="var(--color-schaum)" nach="var(--color-sand-hell)" />

  <section class="bg-sand-hell" aria-labelledby="bilder-titel">
    <div class="seite-breite py-14 lg:py-20">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <h2 id="bilder-titel" class="titel-mittel text-tiefe">Eindrücke</h2>
        <a href="/galerie/" class="textlink font-semibold">Alle Fotos ansehen</a>
      </div>
      {ANZAHL_UEBERNOMMEN === 0 && <Platzhalter class="mt-6 text-tinte">Passende Fotos für „{a.kartenTitel}" aus der bisherigen Galerie auswählen (src/data/galerie.json → anlaesse).</Platzhalter>}
      <GalerieRaster fotos={fotos} mindestens={3} class="mt-10" sammlung={`anlass-${a.slug}`} />

      <div class="cta-band auf-dunkel mt-16" data-reveal="zoom" data-anfrage-verbergen>
        <div>
          <p class="eyebrow">Anfrage</p>
          <h2 class="mt-3 font-display text-3xl leading-tight text-schaum">Ihr {a.kartenTitel} auf der MS Wohldorf?</h2>
          <p class="mt-3 text-nebel">Anlass, Wunschtermin, Gästezahl — wir melden uns persönlich bei Ihnen.</p>
        </div>
        <a href={`/anfrage/?anlass=${a.slug}`} class="knopf knopf-messing shrink-0" data-magnet>Unverbindlich anfragen <Symbol name="pfeil" /></a>
      </div>
    </div>
  </section>

  <section class="bg-sand-hell" aria-labelledby="weitere-titel">
    <div class="seite-breite pb-16 lg:pb-24">
      <h2 id="weitere-titel" class="titel-mittel text-tiefe" data-reveal>Weitere Anlässe</h2>
      <div class="mt-10">
        <AnlassKarten ohne={a.slug} />
      </div>
    </div>
  </section>

  <Lightbox />
</Basis>

<style>
  .bg-schaum {
    background: var(--color-schaum);
  }
  .bg-sand-hell {
    background: var(--color-sand-hell);
  }
  .text-tiefe {
    color: var(--color-tiefe);
  }
  .vorteil {
    padding: 1.4rem 1.3rem;
    border-radius: 1.1rem;
    background: #fff;
    border: 1px solid rgb(11 26 42 / 0.07);
    box-shadow: 0 20px 40px -34px rgb(6 18 31 / 0.5);
  }
  .vorteil-symbol {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.8rem;
    background: var(--color-tiefe);
    color: var(--color-messing-hell);
  }
  .offen-kasten {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 1.4rem;
    background: var(--color-sand-hell);
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: 1.6rem;
    color: var(--color-schaum);
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(43 122 138 / 0.5), transparent 60%),
      var(--color-tiefe);
  }
  @media (min-width: 768px) {
    .cta-band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
