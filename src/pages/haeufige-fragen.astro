---
/**
 * Häufige Fragen — direkte, belegte Antworten (src/data/fragen.ts) mit
 * FAQPage-Schema. Für Suchmaschinen und KI-Assistenten (GEO) die wichtigste
 * Seite, um Fakten zur MS Wohldorf zitierbar zu machen.
 */
import Basis from '../layouts/Basis.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import FragenListe from '../components/FragenListe.astro';
import Symbol from '../components/Symbol.astro';
import ExposeKnopf from '../components/ExposeKnopf.astro';
import { FRAGEN } from '../data/fragen';
import { SEITE } from '../config';

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SEITE.url}/haeufige-fragen/#faq`,
  about: { '@id': `${SEITE.url}/#schiff` },
  inLanguage: 'de-DE',
  mainEntity: FRAGEN.map((f) => ({
    '@type': 'Question',
    name: f.frage,
    acceptedAnswer: { '@type': 'Answer', text: f.antwort },
  })),
};
const brotkrumen = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SEITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Häufige Fragen', item: `${SEITE.url}/haeufige-fragen/` },
  ],
};
---

<Basis
  titel="Häufige Fragen zur MS Wohldorf — Eventschiff in Hamburg"
  beschreibung="Antworten auf die häufigsten Fragen zur MS Wohldorf: Gästezahl, Liegeplatz, Anreise aus Berlin, Räume, Küche, Barrierefreiheit, Besichtigung und Anfrage."
  strukturiert={[faq, brotkrumen]}
  fussVon="var(--color-sand-hell)"
>
  <SeitenKopf
    eyebrow="Häufige Fragen"
    titel="Gut zu wissen, bevor Sie anfragen."
    lead="Die wichtigsten Antworten zur MS Wohldorf auf einen Blick. Ihre Frage ist nicht dabei? Fragen Sie uns einfach."
  />

  <section class="bg-schaum" aria-label="Fragen und Antworten">
    <div class="seite-breite grid gap-12 py-12 lg:grid-cols-[1.4fr_0.6fr] lg:gap-14 lg:py-16">
      <FragenListe fragen={FRAGEN} ersteOffen />
      <aside class="grid content-start gap-6" data-reveal="rechts">
        <div class="kasten-dunkel auf-dunkel">
          <p class="eyebrow">Persönlich</p>
          <h2 class="mt-3 font-display text-2xl leading-tight text-schaum">Noch Fragen?</h2>
          <p class="mt-3 text-nebel">Anlass, Wunschtermin und Gästezahl genügen — wir melden uns persönlich.</p>
          <a href="/anfrage/" class="knopf knopf-messing mt-5 w-full" data-magnet>Unverbindlich anfragen <Symbol name="pfeil" /></a>
          <ExposeKnopf variante="geist" class="mt-3 w-full text-schaum" />
        </div>
        <a href="/offsite-hamburg/" class="kasten-hell">
          <Symbol name="kalender" class="size-6 shrink-0 text-petrol" />
          <span>
            <span class="block font-semibold text-tiefe">Team von außerhalb?</span>
            <span class="block text-sm text-grau">Offsite in Hamburg — Anreise aus Berlin und Norddeutschland</span>
          </span>
        </a>
      </aside>
    </div>
  </section>
</Basis>

<style>
  .bg-schaum {
    background: var(--color-schaum);
  }
  .kasten-dunkel {
    padding: 1.6rem;
    border-radius: 1.4rem;
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(43 122 138 / 0.5), transparent 60%),
      var(--color-tiefe);
  }
  .kasten-hell {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.2rem 1.25rem;
    border-radius: 1.1rem;
    background: var(--color-sand-hell);
    border: 1px solid rgb(11 26 42 / 0.07);
    transition: transform 0.35s var(--ease-welle);
  }
  .kasten-hell:hover {
    transform: translateY(-2px);
  }
</style>
