---
/**
 * Exposé als druckbare Seite (4 × A4). Daraus erzeugt `npm run expose` das PDF
 * public/pdf/ms-wohldorf-expose.pdf (Lead-Magnet, frei herunterladbar).
 * Nicht für Suchmaschinen (noindex, nicht in der Sitemap).
 *
 * Nur belegte Angaben (src/config.ts, src/data/*). Was nicht belegt ist —
 * Preise, Catering, Technik —, steht als Frage in der Planungs-Checkliste.
 */
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { BETREIBER, FAKTEN, KONTAKT, LIEGEPLATZ, SEITE, AUSSTATTUNG } from '../config';
import { ANLAESSE } from '../data/anlaesse';
import { ANREISE } from '../data/anreise';
import { FOTO_DROHNE_2024, foto, fotosFuerAnlass } from '../data/bilder';
import karte from '../assets/karte/anfahrt.png';

const jpg = async (src: ImageMetadata, width: number) => (await getImage({ src, width, format: 'jpg', quality: 76 })).src;

const titelbild = await jpg(FOTO_DROHNE_2024.bild, 1280);
const innen = await Promise.all(['wohldorf_innen_18', 'wohldorf_innen_31', 'wohldorf_innen_15', 'wohldorf_innen_10'].map(async (n) => ({ src: await jpg(foto(n).bild, 900), alt: foto(n).alt })));
const anlaesse = await Promise.all(
  ANLAESSE.map(async (a) => {
    const f = fotosFuerAnlass(a.slug)[0];
    return { ...a, bild: f ? await jpg(f.bild, 600) : null, bildAlt: f?.alt ?? '' };
  }),
);
const kartenbild = await jpg(karte, 1000);
const zitat = ANLAESSE.find((a) => a.zitat)?.zitat;
const stand = new Date().toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
const web = SEITE.url.replace('https://', '');

const raeume = [
  'Hauptdeck: großer Veranstaltungsbereich und ein kleinerer, verglaster Besprechungsraum',
  'Oberdeck: Büro mit Kombüse',
  'Küche mit Geräten an Bord',
  'WLAN und PA-Anlage für Musik und Durchsagen',
  'Zentralheizung mit gusseisernen Heizkörpern',
];
const wissen = [
  `Bis zu ${FAKTEN.maxGaeste} Personen`,
  'Veranstaltungen am Liegeplatz — das Schiff fährt nicht mehr aus eigener Kraft',
  `${AUSSTATTUNG.parkplaetze} Parkplätze direkt vor der Tür, an einer kleinen Privatstraße`,
  'Der Zugang ist nicht barrierefrei',
];
const checkliste = [
  'Anlass und Ziel Ihrer Veranstaltung',
  'Wunschdatum und Ausweichdatum',
  `Gästezahl (bis ${FAKTEN.maxGaeste})`,
  'Uhrzeit und Dauer',
  'Verpflegung und Getränke',
  'Technik über WLAN und PA-Anlage hinaus, z. B. Bildschirm',
  'Ablauf und Programm',
  'Anreise Ihrer Gäste: Bahn, Auto, Taxi',
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MS Wohldorf — Exposé</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="Exposé der MS Wohldorf: Eventschiff in Hamburg für bis zu 35 Gäste." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="expose">
    <!-- 1 · Titel -->
    <section class="blatt titel">
      <img class="titel-bild" src={titelbild} alt={FOTO_DROHNE_2024.alt} />
      <div class="titel-schleier"></div>
      <div class="titel-kopf">
        <p class="marke">MS Wohldorf</p>
        <p class="unterzeile">Eventschiff · Hamburg</p>
      </div>
      <div class="titel-inhalt">
        <p class="eyebrow-druck">Exposé</p>
        <h1>Eine historische Hafenfähre für Ihren Anlass.</h1>
        <p class="titel-lead">
          Firmenevent, Workshop, Offsite, Film und Foto, Lesung, Ausstellung oder private Feier — an Bord der MS Wohldorf, {LIEGEPLATZ.beschreibung}.
        </p>
        <ul class="fakten">
          <li><strong>{FAKTEN.maxGaeste}</strong><span>Gäste</span></li>
          <li><strong>{FAKTEN.baujahr}</strong><span>HADAG-Fähre</span></li>
          <li><strong>{FAKTEN.umbau}</strong><span>Umbau</span></li>
          <li><strong>{ANREISE.hbfKm} km</strong><span>ab Hamburg Hbf</span></li>
        </ul>
      </div>
      <p class="titel-fuss">{KONTAKT.person} · {KONTAKT.telefon} · {KONTAKT.mail} · {web}</p>
    </section>

    <!-- 2 · An Bord -->
    <section class="blatt">
      <p class="eyebrow-druck">An Bord</p>
      <h2>Ein Schiff mit Geschichte — und Platz für Ihre Idee.</h2>
      <p class="einleitung">
        Die MS Wohldorf wurde {FAKTEN.baujahr} als {FAKTEN.herkunft} in Dienst gestellt — einst für bis zu {FAKTEN.fahrgaesteFrueher} Fahrgäste.{' '}
        {FAKTEN.umbau} wurde sie zum Büro- und Veranstaltungsschiff umgebaut. Heute liegt sie {LIEGEPLATZ.beschreibung}.
      </p>
      <div class="spalten">
        <div>
          <h3>Räume und Ausstattung</h3>
          <ul class="liste">{raeume.map((r) => <li>{r}</li>)}</ul>
        </div>
        <div>
          <h3>Gut zu wissen</h3>
          <ul class="liste">{wissen.map((w) => <li>{w}</li>)}</ul>
        </div>
      </div>
      <div class="bilder">
        {innen.map((b) => <img src={b.src} alt={b.alt} />)}
      </div>
      <p class="hinweis">Im 3D-Rundgang bewegen Sie sich frei durch das Schiff: {web}/#rundgang</p>
      <p class="fuss">MS Wohldorf · Exposé · Seite 2</p>
    </section>

    <!-- 3 · Anlässe -->
    <section class="blatt">
      <p class="eyebrow-druck">Anlässe</p>
      <h2>Fünf Wege an Bord.</h2>
      <ul class="anlaesse">
        {
          anlaesse.map((a) => (
            <li>
              {a.bild && <img src={a.bild} alt={a.bildAlt} />}
              <div>
                <h3>{a.kartenTitel}</h3>
                <p>{a.kartenText}</p>
                <p class="link">
                  {web}/anlaesse/{a.slug}/
                </p>
              </div>
            </li>
          ))
        }
      </ul>
      {
        zitat && (
          <figure class="zitat">
            <blockquote>„{zitat.text}“</blockquote>
            <figcaption>
              {zitat.name} · {zitat.zusatz}
            </figcaption>
          </figure>
        )
      }
      <p class="fuss">MS Wohldorf · Exposé · Seite 3</p>
    </section>

    <!-- 4 · Anreise & Planung -->
    <section class="blatt">
      <p class="eyebrow-druck">Anreise und Planung</p>
      <h2>Gut erreichbar — auch aus Berlin.</h2>
      <div class="spalten">
        <div>
          <h3>Anreise</h3>
          <ul class="liste">
            <li>Aus Berlin: mit dem ICE in {ANREISE.berlinBahn} bis Hamburg Hbf</li>
            <li>Ab Hamburg Hbf: rund {ANREISE.hbfKm} km mit Taxi oder Auto, je nach Verkehr {ANREISE.hbfMinuten}</li>
            <li>Ab Flughafen Hamburg: rund {ANREISE.flughafenKm} km, {ANREISE.flughafenMinuten}</li>
            <li>Liegeplatz: {LIEGEPLATZ.name}, Navi: {LIEGEPLATZ.navi}</li>
          </ul>
          <img class="karte" src={kartenbild} alt="Kartenausschnitt mit dem Liegeplatz der MS Wohldorf an der Süderelbe." />
          <p class="quelle">Karte: © OpenStreetMap-Mitwirkende, ODbL</p>
        </div>
        <div>
          <h3>Checkliste für Ihre Anfrage</h3>
          <ul class="checkliste">{checkliste.map((c) => <li>{c}</li>)}</ul>
          <div class="weiter">
            <p class="weiter-titel">So geht es weiter</p>
            <p>Schreiben Sie uns Anlass, Wunschtermin und Gästezahl — wir melden uns persönlich mit Verfügbarkeit und Angebot.</p>
            <p class="weiter-kontakt">
              {web}/anfrage/<br />
              {KONTAKT.mail} · {KONTAKT.telefon}<br />
              Ihr Ansprechpartner: {KONTAKT.person}
            </p>
          </div>
        </div>
      </div>
      <div class="online">
        <p class="online-titel">Mehr sehen auf {web}</p>
        <ul>
          <li><strong>3D-Rundgang</strong><span>/#rundgang</span></li>
          <li><strong>Galerie</strong><span>/galerie/</span></li>
          <li><strong>Häufige Fragen</strong><span>/haeufige-fragen/</span></li>
          <li><strong>Offsite für Teams</strong><span>/offsite-hamburg/</span></li>
        </ul>
      </div>
      <p class="fuss">
        {BETREIBER.firma} · {BETREIBER.strasse}, {BETREIBER.plz} {BETREIBER.ort} · {web} · Stand: {stand} · Preise auf Anfrage
      </p>
    </section>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  .expose {
    margin: 0;
    background: #d9dde2;
    color: var(--color-tinte);
    font-family: var(--font-sans);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .blatt {
    position: relative;
    box-sizing: border-box;
    width: 210mm;
    height: 297mm;
    margin: 10mm auto;
    padding: 18mm 18mm 16mm;
    overflow: hidden;
    background: var(--color-schaum);
    box-shadow: 0 10px 40px -10px rgb(0 0 0 / 0.35);
    break-after: page;
  }
  @media print {
    .expose {
      background: none;
    }
    .blatt {
      margin: 0;
      box-shadow: none;
    }
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--color-tiefe);
  }
  h2 {
    margin: 3mm 0 0;
    font-size: 23pt;
    line-height: 1.12;
  }
  h3 {
    margin: 0 0 2.5mm;
    font-size: 13pt;
  }
  .eyebrow-druck {
    margin: 0;
    font-size: 8pt;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-messing-dunkel);
  }
  .einleitung {
    margin: 5mm 0 0;
    font-size: 11pt;
    line-height: 1.55;
    color: var(--color-grau);
  }
  .spalten {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9mm;
    margin-top: 8mm;
  }
  .liste,
  .checkliste {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2.2mm;
    font-size: 10pt;
    line-height: 1.45;
  }
  .liste li {
    padding-left: 5mm;
    position: relative;
  }
  .liste li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.9mm;
    width: 2mm;
    height: 2mm;
    border-radius: 999px;
    background: var(--color-messing);
  }
  .checkliste li {
    padding-left: 7mm;
    position: relative;
  }
  .checkliste li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6mm;
    width: 3.6mm;
    height: 3.6mm;
    border: 1.2px solid var(--color-petrol);
    border-radius: 1mm;
  }
  .bilder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3mm;
    margin-top: 9mm;
  }
  .bilder img {
    width: 100%;
    height: 52mm;
    object-fit: cover;
    border-radius: 2.5mm;
  }
  .hinweis {
    margin: 5mm 0 0;
    font-size: 9.5pt;
    color: var(--color-petrol);
    font-weight: 600;
  }
  .fuss {
    position: absolute;
    left: 18mm;
    right: 18mm;
    bottom: 9mm;
    margin: 0;
    padding-top: 3mm;
    border-top: 0.6px solid rgb(11 26 42 / 0.2);
    font-size: 7.5pt;
    color: var(--color-grau);
  }

  /* Titel */
  .titel {
    padding: 0;
    background: var(--color-tiefe);
    color: var(--color-schaum);
  }
  .titel-bild {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 62%;
    object-fit: cover;
  }
  .titel-schleier {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(6 18 31 / 0.55) 0%, transparent 22%),
      linear-gradient(to top, var(--color-tiefe) 40%, rgb(10 29 48 / 0.2) 62%, transparent 75%);
  }
  .titel-kopf {
    position: absolute;
    top: 16mm;
    left: 18mm;
  }
  .marke {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18pt;
    font-weight: 600;
    color: var(--color-schaum);
  }
  .unterzeile {
    margin: 1mm 0 0;
    font-size: 7.5pt;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-messing-hell);
  }
  .titel-inhalt {
    position: absolute;
    left: 18mm;
    right: 18mm;
    bottom: 34mm;
  }
  .titel .eyebrow-druck {
    color: var(--color-messing-hell);
  }
  .titel h1 {
    margin: 3mm 0 0;
    font-size: 32pt;
    line-height: 1.06;
    color: var(--color-schaum);
  }
  .titel-lead {
    margin: 5mm 0 0;
    max-width: 150mm;
    font-size: 11.5pt;
    line-height: 1.5;
    color: var(--color-nebel);
  }
  .fakten {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4mm;
    margin: 9mm 0 0;
    padding: 0;
    list-style: none;
  }
  .fakten li {
    padding-top: 3mm;
    border-top: 1.2px solid var(--color-messing);
  }
  .fakten strong {
    display: block;
    font-family: var(--font-display);
    font-size: 20pt;
    font-weight: 560;
    color: var(--color-schaum);
  }
  .fakten span {
    font-size: 8.5pt;
    color: var(--color-nebel);
  }
  .titel-fuss {
    position: absolute;
    left: 18mm;
    right: 18mm;
    bottom: 12mm;
    margin: 0;
    padding-top: 3mm;
    border-top: 0.6px solid rgb(255 255 255 / 0.25);
    font-size: 8.5pt;
    color: var(--color-nebel);
  }

  /* Anlässe */
  .anlaesse {
    display: grid;
    gap: 5mm;
    margin: 8mm 0 0;
    padding: 0;
    list-style: none;
  }
  .anlaesse li {
    display: grid;
    grid-template-columns: 42mm 1fr;
    gap: 6mm;
    align-items: center;
  }
  .anlaesse img {
    width: 42mm;
    height: 28mm;
    object-fit: cover;
    border-radius: 2mm;
  }
  .anlaesse h3 {
    margin: 0;
  }
  .anlaesse p {
    margin: 1mm 0 0;
    font-size: 10pt;
    line-height: 1.45;
    color: var(--color-grau);
  }
  .anlaesse .link {
    font-size: 8.5pt;
    color: var(--color-petrol);
    font-weight: 600;
  }
  .zitat {
    margin: 9mm 0 0;
    padding: 5mm 6mm;
    border-left: 1.2mm solid var(--color-messing);
    border-radius: 2mm;
    background: #fff;
  }
  .zitat blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 11.5pt;
    line-height: 1.45;
    color: var(--color-tiefe);
  }
  .zitat figcaption {
    margin-top: 2mm;
    font-size: 8.5pt;
    color: var(--color-grau);
  }

  /* Anreise */
  .karte {
    width: 100%;
    height: 72mm;
    margin-top: 6mm;
    object-fit: cover;
    border-radius: 2.5mm;
  }
  .quelle {
    margin: 1.5mm 0 0;
    font-size: 7pt;
    color: var(--color-grau);
  }
  .weiter {
    margin-top: 8mm;
    padding: 6mm;
    border-radius: 3mm;
    background: var(--color-tiefe);
    color: var(--color-nebel);
    font-size: 10pt;
    line-height: 1.5;
  }
  .weiter p {
    margin: 0;
  }
  .weiter-titel {
    font-family: var(--font-display);
    font-size: 14pt;
    color: var(--color-schaum);
    margin-bottom: 2mm !important;
  }
  .online {
    margin-top: 12mm;
    padding-top: 6mm;
    border-top: 1.2px solid var(--color-messing);
  }
  .online-titel {
    margin: 0 0 4mm;
    font-family: var(--font-display);
    font-size: 14pt;
    color: var(--color-tiefe);
  }
  .online ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4mm;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .online li {
    padding: 4mm;
    border-radius: 2.5mm;
    background: #fff;
    border: 0.6px solid rgb(11 26 42 / 0.12);
  }
  .online strong {
    display: block;
    font-size: 10pt;
    color: var(--color-tiefe);
  }
  .online span {
    display: block;
    margin-top: 1.5mm;
    font-size: 7.5pt;
    color: var(--color-petrol);
    font-weight: 600;
  }
  .weiter-kontakt {
    margin-top: 3mm !important;
    color: var(--color-messing-hell);
    font-weight: 600;
  }
</style>
