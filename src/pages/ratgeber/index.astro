---
/** Ratgeber — Übersicht aller Artikel (src/content/ratgeber/). */
import Basis from '../../layouts/Basis.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import RatgeberKarte from '../../components/RatgeberKarte.astro';
import ExposeKnopf from '../../components/ExposeKnopf.astro';
import Symbol from '../../components/Symbol.astro';
import { ratgeberArtikel } from '../../lib/ratgeber';
import { SEITE } from '../../config';

const artikel = await ratgeberArtikel();
const liste = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SEITE.url}/ratgeber/#blog`,
  name: 'Ratgeber der MS Wohldorf',
  url: `${SEITE.url}/ratgeber/`,
  inLanguage: 'de-DE',
  about: { '@id': `${SEITE.url}/#schiff` },
  blogPost: artikel.map((a) => ({ '@type': 'BlogPosting', headline: a.data.titel, url: `${SEITE.url}/ratgeber/${a.id}/` })),
};
const brotkrumen = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SEITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Ratgeber', item: `${SEITE.url}/ratgeber/` },
  ],
};
---

<Basis
  titel="Ratgeber — Veranstaltungen, Offsites und Geschichte der MS Wohldorf"
  beschreibung="Ratgeber der MS Wohldorf: Offsite in Hamburg planen, Workshops an Bord, die Geschichte der HADAG-Hafenfähre von 1959 — mit Checklisten und Quellen."
  strukturiert={[liste, brotkrumen]}
  fussVon="var(--color-sand-hell)"
>
  <SeitenKopf eyebrow="Ratgeber" titel="Wissen für Ihren Anlass an Bord." lead="Planungshilfen, Erfahrungen und Geschichte rund um die MS Wohldorf — mit Checklisten und Quellen." />

  <section class="bg-schaum" aria-label="Artikel">
    <div class="seite-breite py-12 lg:py-16">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-gruppe>
        {artikel.map((a) => <RatgeberKarte artikel={a} />)}
      </div>
      <div class="ratgeber-band mt-14" data-reveal>
        <div>
          <p class="font-display text-2xl text-tiefe">Lieber alles auf einen Blick?</p>
          <p class="mt-1 text-grau">Räume, Anlässe, Anreise und Checkliste — im Exposé.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <ExposeKnopf />
          <a href="/anfrage/" class="knopf knopf-messing" data-magnet>Anfrage <Symbol name="pfeil" /></a>
        </div>
      </div>
    </div>
  </section>
</Basis>

<style>
  .bg-schaum {
    background: var(--color-schaum);
  }
  .ratgeber-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem 1.6rem;
    border-radius: 1.3rem;
    background: var(--color-sand-hell);
    border: 1px solid rgb(11 26 42 / 0.07);
  }
</style>
