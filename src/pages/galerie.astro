---
import Basis from '../layouts/Basis.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import GalerieRaster from '../components/GalerieRaster.astro';
import Karussell from '../components/Karussell.astro';
import Lightbox from '../components/Lightbox.astro';
import Platzhalter from '../components/Platzhalter.astro';
import Symbol from '../components/Symbol.astro';
import { FOTOS, ANZAHL_UEBERNOMMEN } from '../data/bilder';
---

<Basis
  titel="Galerie — Fotos der MS Wohldorf in Hamburg"
  beschreibung="Fotos der MS Wohldorf: die historische Hamburger Hafenfähre von 1959 an ihrem Liegeplatz und im Sandtorhafen. Eindrücke für Ihr Event an Bord."
  fussVon="var(--color-schaum)"
>
  <SeitenKopf eyebrow="Galerie" titel="Die MS Wohldorf in Bildern." lead="Drehen Sie das Karussell, öffnen Sie ein Foto groß — oder wechseln Sie zur klassischen Rasteransicht." />

  <section class="bg-schaum" aria-labelledby="fotos-titel">
    <div class="seite-breite py-12 lg:py-16">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <h2 id="fotos-titel" class="font-display text-2xl text-tiefe">{FOTOS.length} {FOTOS.length === 1 ? 'Foto' : 'Fotos'}</h2>
        <div class="ansicht nur-js" role="group" aria-label="Ansicht wählen">
          <button type="button" class="ansicht-knopf" aria-pressed="true" data-ansicht="karussell">
            <Symbol name="karussell" class="size-5" /> 3D-Karussell
          </button>
          <button type="button" class="ansicht-knopf" aria-pressed="false" data-ansicht="raster">
            <Symbol name="raster" class="size-5" /> Raster
          </button>
        </div>
      </div>

      {
        ANZAHL_UEBERNOMMEN === 0 && (
          <Platzhalter class="mt-6 text-tinte">
            Die Fotos der bisherigen Galerie (images/galerie/…) werden mit „npm run alte-seite" übernommen — die alte Seite war beim Bau
            nicht erreichbar. Bis dahin zeigt die Galerie zwei Standbilder aus den eigenen Videos.
          </Platzhalter>
        )
      }

      <div class="mt-10" data-ansicht-flaeche="karussell" hidden>
        <Karussell fotos={FOTOS} mindestens={10} />
      </div>
      <div class="mt-10" data-ansicht-flaeche="raster">
        <GalerieRaster fotos={FOTOS} mindestens={9} sammlung="raster" />
      </div>
    </div>
  </section>

  <Lightbox />
</Basis>

<script>
  import { bewegungErlaubt, beiBewegungsWechsel } from '../scripts/bewegung';

  const knoepfe = [...document.querySelectorAll<HTMLButtonElement>('[data-ansicht]')];
  const flaechen = [...document.querySelectorAll<HTMLElement>('[data-ansicht-flaeche]')];
  const setze = (ansicht: string) => {
    knoepfe.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.ansicht === ansicht)));
    flaechen.forEach((f) => (f.hidden = f.dataset.ansichtFlaeche !== ansicht));
    window.dispatchEvent(new Event('resize'));
  };
  knoepfe.forEach((k) => k.addEventListener('click', () => setze(k.dataset.ansicht!)));
  setze(bewegungErlaubt() ? 'karussell' : 'raster');
  beiBewegungsWechsel((an) => {
    if (!an) setze('raster');
  });
</script>

<style>
  .bg-schaum {
    background: var(--color-schaum);
  }
  .text-tiefe {
    color: var(--color-tiefe);
  }
  .ansicht {
    display: inline-flex;
    padding: 0.3rem;
    border-radius: 999px;
    background: var(--color-sand-hell);
    border: 1px solid rgb(11 26 42 / 0.08);
  }
  .ansicht-knopf {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--color-grau);
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .ansicht-knopf[aria-pressed='true'] {
    background: var(--color-tiefe);
    color: var(--color-schaum);
  }
  :global(html:not(.js)) .nur-js {
    display: none;
  }
</style>
