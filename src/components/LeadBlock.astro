---
/**
 * Lead-Block: links das Exposé (frei, ohne E-Mail), rechts die Schnellanfrage.
 * Steht auf den Anlass-Seiten und auf /offsite-hamburg/ anstelle des CTA-Bands.
 */
import { Picture } from 'astro:assets';
import AnfrageFormular from './AnfrageFormular.astro';
import ExposeKnopf from './ExposeKnopf.astro';
import Symbol from './Symbol.astro';
import type { AnlassWert } from '../data/typen';
import { FOTO_DROHNE_2024 } from '../data/bilder';
import { FAKTEN } from '../config';

interface Props {
  id: string;
  titel: string;
  vorauswahl?: AnlassWert;
  sprache?: 'de' | 'en';
}
const { id, titel, vorauswahl, sprache = 'de' } = Astro.props;
const en = sprache === 'en';
const inhalt = en
  ? ['Rooms and facilities on board', 'All occasions at a glance', 'Getting there from Berlin and Hamburg', 'Checklist for your planning']
  : ['Räume und Ausstattung an Bord', 'Alle Anlässe auf einen Blick', 'Anreise aus Berlin und Hamburg', 'Checkliste für Ihre Planung'];
---

<section class="lead-block" aria-labelledby={`${id}-titel`} data-anfrage-verbergen>
  <div class="lead-expose auf-dunkel" data-reveal="links">
    <div class="lead-cover" aria-hidden="true">
      <Picture src={FOTO_DROHNE_2024.bild} alt="" formats={['avif', 'webp']} widths={[320, 480]} sizes="12rem" loading="lazy" class="h-full w-full object-cover" />
      <span class="lead-cover-titel">MS Wohldorf<br /><span>Exposé</span></span>
    </div>
    <p class="eyebrow mt-6">{en ? 'Exposé · free · in German' : 'Exposé · kostenlos'}</p>
    <h2 id={`${id}-titel`} class="mt-3 font-display text-3xl leading-tight text-schaum">{titel}</h2>
    <ul class="mt-5 grid gap-2 text-nebel">
      {
        inhalt.map((z) => (
          <li class="flex items-start gap-2">
            <Symbol name="haken" class="mt-0.5 size-5 shrink-0 text-messing-hell" />
            <span>{z}</span>
          </li>
        ))
      }
    </ul>
    <ExposeKnopf variante="messing" class="mt-7" sprache={sprache} />
    <p class="mt-3 text-sm text-nebel">{en ? 'No sign-up, no email.' : 'Ohne Anmeldung, ohne E-Mail.'}</p>
  </div>

  <div class="lead-formular" data-reveal="rechts">
    <p class="eyebrow eyebrow-hell">{en ? 'Quick enquiry' : 'Schnellanfrage'}</p>
    <h3 class="mt-3 font-display text-2xl leading-tight text-tiefe">{en ? 'Is your date still free?' : 'Ist Ihr Termin noch frei?'}</h3>
    <p class="mt-2 text-grau">
      {en ? `For up to ${FAKTEN.maxGaeste} guests. We will get back to you personally with availability and an offer.` : `Für bis zu ${FAKTEN.maxGaeste} Gäste. Wir melden uns persönlich mit Verfügbarkeit und Angebot.`}
    </p>
    <div class="mt-6">
      <AnfrageFormular id={id} schnell vorauswahl={vorauswahl} sprache={sprache} />
    </div>
  </div>
</section>

<style>
  .lead-block {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 1024px) {
    .lead-block {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: stretch;
    }
  }
  .lead-expose {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.6rem;
    color: var(--color-schaum);
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(43 122 138 / 0.5), transparent 60%),
      var(--color-tiefe);
  }
  .lead-cover {
    position: relative;
    width: 9.5rem;
    aspect-ratio: 210 / 297;
    overflow: hidden;
    border-radius: 0.5rem;
    box-shadow:
      0 30px 50px -20px rgb(0 0 0 / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.12);
    transform: rotate(-4deg);
    transition: transform 0.6s var(--ease-welle);
  }
  .lead-expose:hover .lead-cover {
    transform: rotate(-1deg) translateY(-4px);
  }
  .lead-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(6 18 31 / 0.92) 0%, rgb(6 18 31 / 0.15) 55%, transparent);
  }
  .lead-cover-titel {
    position: absolute;
    z-index: 1;
    left: 0.75rem;
    bottom: 0.7rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.1;
    color: var(--color-schaum);
  }
  .lead-cover-titel span {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-messing-hell);
  }
  .lead-formular {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.6rem;
    background: #fff;
    border: 1px solid rgb(11 26 42 / 0.08);
    box-shadow: 0 40px 80px -50px rgb(6 18 31 / 0.5);
  }
  .eyebrow-hell {
    color: var(--color-messing-dunkel);
  }
</style>
