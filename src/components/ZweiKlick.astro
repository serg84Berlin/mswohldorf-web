---
/**
 * Zwei-Klick-Lösung für Inhalte Dritter (YouTube, Matterport, OpenStreetMap).
 * Vor dem Klick wird NICHTS vom Anbieter geladen — nur ein eigenes Vorschaubild.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Symbol from './Symbol.astro';

interface Props {
  art: 'youtube' | 'matterport' | 'karte';
  /** Adresse, die erst nach dem Klick als iframe geladen wird. */
  src: string;
  titel: string;
  anbieter: string;
  /** Link, um den Inhalt direkt beim Anbieter zu öffnen. */
  direkt: string;
  poster?: ImageMetadata;
  posterAlt?: string;
  format?: string;
  class?: string;
}
const { art, src, titel, anbieter, direkt, poster, posterAlt = '', format = '16 / 9', class: klasse = '' } = Astro.props;
const symbol = art === 'youtube' ? 'play' : art === 'matterport' ? 'wuerfel' : 'karte';
const erlaubt =
  art === 'youtube'
    ? 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen'
    : art === 'matterport'
      ? 'fullscreen; xr-spatial-tracking; autoplay'
      : '';
---

<figure class:list={['zweiklick auf-dunkel', klasse]} style={`--format:${format}`} data-zweiklick data-src={src} data-titel={titel} data-erlaubt={erlaubt}>
  <div class="zk-flaeche" data-zk-flaeche>
    {poster && <Picture src={poster} alt={posterAlt} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" class="zk-poster" loading="lazy" />}
    <div class="zk-schleier" aria-hidden="true"></div>
    <div class="zk-inhalt">
      <span class="zk-symbol" aria-hidden="true"><Symbol name={symbol} class="size-7" /></span>
      <p class="zk-titel">{titel}</p>
      <p class="zk-hinweis">
        Erst nach Ihrem Klick wird der Inhalt von {anbieter} geladen. Dabei werden Daten wie Ihre IP-Adresse an {anbieter} übertragen.{' '}
        <a href="/datenschutz/#einbettungen" class="underline underline-offset-2">Mehr in der Datenschutzerklärung</a>.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
        <button type="button" class="knopf knopf-messing nur-js" data-zk-laden>
          Inhalt laden <span class="text-[0.85em] font-medium opacity-80">(Daten gehen an {anbieter})</span>
        </button>
        <a href={direkt} target="_blank" rel="noopener" class="zk-direkt">
          Direkt bei {anbieter} öffnen <Symbol name="extern" class="size-4" /><span class="sr-only"> (neues Fenster)</span>
        </a>
      </div>
    </div>
  </div>
  <figcaption class="sr-only">{titel}</figcaption>
</figure>

<script>
  import '../scripts/zweiklick';
</script>

<style>
  .zweiklick {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    background:
      radial-gradient(80% 80% at 70% 20%, rgb(43 122 138 / 0.45), transparent 60%),
      var(--color-marine);
    box-shadow: 0 40px 80px -40px rgb(6 18 31 / 0.65);
    border: 1px solid rgb(255 255 255 / 0.08);
  }
  .zk-flaeche {
    position: relative;
    aspect-ratio: var(--format);
    min-width: 0;
    display: grid;
    place-items: center;
  }
  /* Schmal: Höhe nach Inhalt (sonst überträgt aspect-ratio die Mindesthöhe
     in eine Mindestbreite und die Seite scrollt seitlich). */
  @media (max-width: 640px) {
    .zk-flaeche {
      aspect-ratio: auto;
      min-height: 20rem;
    }
  }
  .zk-flaeche :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .zk-flaeche :global(.zk-poster),
  .zk-flaeche :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .zk-flaeche :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zk-schleier {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 18 31 / 0.55), rgb(6 18 31 / 0.85));
  }
  .zk-inhalt {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.8rem;
    padding: 1.5rem 1.25rem;
    max-width: 34rem;
    color: var(--color-schaum);
  }
  .zk-symbol {
    display: inline-grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 999px;
    background: rgb(224 184 114 / 0.95);
    color: var(--color-tiefe);
    box-shadow: 0 0 0 10px rgb(224 184 114 / 0.16);
  }
  .zk-titel {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .zk-hinweis {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-sand);
  }
  .zk-direkt {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--color-sand);
  }
  :global(html:not(.js)) .nur-js {
    display: none;
  }
</style>
