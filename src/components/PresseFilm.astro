---
import { MEDIEN } from '../config';
import { FOTO_DROHNE_2024, FOTO_SANDTORHAFEN_2017 } from '../data/bilder';
import presse from '../data/presse.json';
import ZweiKlick from './ZweiKlick.astro';
import Symbol from './Symbol.astro';
import Platzhalter from './Platzhalter.astro';

const poster = [FOTO_DROHNE_2024, FOTO_SANDTORHAFEN_2017];
const eintraege = (presse as { eintraege: { datei: string; titel: string }[] }).eintraege;
---

<section class="presse" aria-labelledby="presse-titel">
  <div class="seite-breite py-20 lg:py-28">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
      <div class="max-w-2xl">
        <p class="eyebrow">Film &amp; Presse</p>
        <h2 id="presse-titel" class="titel-mittel mt-4 text-tiefe">Die Wohldorf in Bewegtbild und Presse.</h2>
      </div>
      <p class="max-w-md text-grau">Videos werden erst nach Ihrem Klick von YouTube geladen (über youtube-nocookie.com).</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2" data-reveal-gruppe>
      {
        MEDIEN.videos.map((v, i) => (
          <div data-reveal>
            <ZweiKlick
              art="youtube"
              src={`https://www.youtube-nocookie.com/embed/${v.id}?autoplay=1&rel=0&modestbranding=1`}
              titel={v.titel}
              anbieter="YouTube"
              direkt={`https://www.youtube.com/watch?v=${v.id}`}
              poster={poster[i].bild}
              posterAlt=""
            />
            <p class="mt-3 text-sm text-grau">
              „{v.titel}" · YouTube-Kanal {v.kanal}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_1fr]">
      <a href={MEDIEN.malizia.url} target="_blank" rel="noopener" class="malizia-karte" data-reveal>
        <span class="eyebrow">Segelsport</span>
        <span class="mt-3 block font-display text-2xl leading-tight text-tiefe">Basislager für Boris Herrmann</span>
        <span class="mt-3 block text-grau">Video von {MEDIEN.malizia.kanal}: „{MEDIEN.malizia.titel}"</span>
        <span class="mt-5 inline-flex items-center gap-2 font-semibold text-petrol">
          Auf YouTube ansehen <Symbol name="extern" class="size-4" /><span class="sr-only"> (neues Fenster)</span>
        </span>
      </a>
      <div class="presse-liste" data-reveal>
        <h3 class="font-display text-2xl text-tiefe">Presseberichte</h3>
        {
          eintraege.length > 0 ? (
            <ul class="mt-4 grid gap-2">
              {eintraege.map((e) => (
                <li>
                  <a class="pdf-link" href={`/pdf/${e.datei}`} target="_blank" rel="noopener">
                    <Symbol name="dokument" class="size-5 shrink-0 text-petrol" />
                    <span>{e.titel}</span>
                    <span class="ml-auto text-xs text-grau">PDF</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <Platzhalter class="mt-4 text-tinte">
              Presse-PDFs der bisherigen Website (Ordner ./pdf/) mit Titel, Medium und Datum — werden mit „npm run alte-seite" übernommen.
            </Platzhalter>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .presse {
    background: var(--color-schaum);
  }
  .text-tiefe {
    color: var(--color-tiefe);
  }
  .malizia-karte,
  .presse-liste {
    display: block;
    height: 100%;
    padding: 1.8rem 1.6rem;
    border-radius: 1.3rem;
    background: var(--color-sand-hell);
    border: 1px solid rgb(11 26 42 / 0.08);
  }
  .malizia-karte {
    transition:
      transform 0.5s var(--ease-welle),
      box-shadow 0.4s;
  }
  .malizia-karte:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -40px rgb(6 18 31 / 0.6);
  }
  .pdf-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.9rem;
    border-radius: 0.75rem;
    background: var(--color-schaum);
    border: 1px solid rgb(11 26 42 / 0.08);
  }
  .pdf-link:hover {
    border-color: var(--color-petrol);
  }
</style>
