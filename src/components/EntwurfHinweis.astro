---
/**
 * Hinweis „Entwurf — vor Veröffentlichung rechtlich prüfen“.
 * Abschalten: ENTWURF_HINWEIS_ANZEIGEN in src/config.ts auf false.
 *
 * Im Produktions-Build (ohne PUBLIC_VORSCHAU=1) trägt der Hinweis
 * `data-livegang-sperre`: Der Build bricht dann ab
 * (integrationen/livegang-sperre.mjs), damit die Datenschutzerklärung nicht
 * versehentlich als Entwurf live geht. In der Vorschau bleibt er nur sichtbar.
 */
import { ENTWURF_HINWEIS_ANZEIGEN, VORSCHAU } from '../config';
import Symbol from './Symbol.astro';

interface Props {
  /** Standard: der Schalter in src/config.ts (Prop nur für die Prüfungen). */
  anzeigen?: boolean;
}
const { anzeigen = ENTWURF_HINWEIS_ANZEIGEN } = Astro.props;
const sperre = VORSCHAU
  ? undefined
  : `Entwurf-Hinweis ist an — nach der rechtlichen Prüfung in src/config.ts ENTWURF_HINWEIS_ANZEIGEN = false setzen`;
---

{
  anzeigen && (
    <div class="entwurf" role="note" data-entwurf-hinweis data-livegang-sperre={sperre}>
      <Symbol name="hinweis" class="size-6 shrink-0" />
      <p>
        <strong>Entwurf — vor Veröffentlichung rechtlich prüfen.</strong> Dieser Text ist ein sorgfältig erstellter
        Entwurf, aber keine Rechtsberatung.
      </p>
    </div>
  )
}

<style>
  .entwurf {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    border: 2px solid #b4541a;
    background: #fff4e8;
    color: #6b2c05;
    padding: 1rem 1.15rem;
    border-radius: 0.9rem;
    margin-bottom: 2rem;
  }
</style>
