---
/** Dunkler Seitenkopf für Unterseiten, mit Welle in den hellen Inhalt. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Welle from './Welle.astro';

interface Props {
  eyebrow: string;
  titel: string;
  lead?: string;
  bild?: ImageMetadata;
  bildAlt?: string;
  nach?: string;
}
const { eyebrow, titel, lead, bild, bildAlt = '', nach = 'var(--color-schaum)' } = Astro.props;
const woerter = titel.split(' ');
---

<section class="seitenkopf auf-dunkel" data-anfrage-verbergen>
  <div class="seitenkopf-glanz" aria-hidden="true"></div>
  <div class:list={['seite-breite relative grid items-center gap-10 pt-28 pb-12 lg:pt-36 lg:pb-16', { 'lg:grid-cols-[1.1fr_0.9fr]': bild }]}>
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="titel-gross wort-animiert mt-4 text-schaum">
        {woerter.map((w, i) => <span class="wort" style={`--i:${i}`}>{w}{i < woerter.length - 1 ? ' ' : ''}</span>)}
      </h1>
      {lead && <p class="lead mt-6 max-w-2xl text-nebel" data-reveal>{lead}</p>}
      <slot />
    </div>
    {
      bild && (
        <div class="seitenkopf-bild" data-reveal="zoom">
          <Picture src={bild} alt={bildAlt} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 100vw" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
        </div>
      )
    }
  </div>
  <Welle von="transparent" nach={nach} />
</section>

<style>
  .seitenkopf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-schaum);
    background:
      radial-gradient(120% 90% at 85% 0%, rgb(43 122 138 / 0.35), transparent 60%),
      radial-gradient(80% 60% at 0% 100%, rgb(200 150 62 / 0.14), transparent 60%),
      var(--color-tiefe);
  }
  .seitenkopf-glanz {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-linear-gradient(115deg, rgb(255 255 255 / 0.025) 0 2px, transparent 2px 22px);
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }
  .seitenkopf-bild {
    aspect-ratio: 4 / 3;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.1);
  }
  .seitenkopf-bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
