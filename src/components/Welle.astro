---
/**
 * Animierter Wellen-Trenner zwischen zwei Abschnitten.
 * `von` = Farbe des Abschnitts darüber, `nach` = Farbe darunter.
 * Drei Wellenzüge laufen langsam gegeneinander; bei reduzierter Bewegung
 * stehen sie still (globale Regel in global.css).
 */
interface Props {
  von: string;
  nach: string;
  class?: string;
}
const { von, nach, class: klasse = '' } = Astro.props;

// Eine Periode = 600 Einheiten, Pfad über 2400 (vier Perioden): Verschieben um
// die Hälfte ergibt eine nahtlose Schleife.
function kamm(y: number, a: number) {
  let d = `M0 ${y}`;
  for (let x = 0; x < 2400; x += 600) {
    d += ` C ${x + 150} ${y - a}, ${x + 450} ${y + a}, ${x + 600} ${y}`;
  }
  return d;
}
// Fläche bis unter den Rand (100 > viewBox 90), damit keine Haarlinie bleibt.
const zug = (y: number, a: number) => `${kamm(y, a)} L2400 100 L0 100 Z`;
---

<div class:list={['welle', klasse]} style={`--von:${von};--nach:${nach}`} aria-hidden="true">
  <svg viewBox="0 0 1200 90" preserveAspectRatio="none" focusable="false">
    <g class="welle-spur rueckwaerts" style="--dauer:29s"><path d={zug(40, 18)} fill="var(--nach)" opacity="0.32" /></g>
    <g class="welle-spur" style="--dauer:19s">
      <path d={zug(58, 13)} fill="var(--nach)" />
      <path d={kamm(58, 13)} fill="none" stroke="#c8963e" stroke-width="1.4" stroke-opacity="0.75" vector-effect="non-scaling-stroke" />
    </g>
  </svg>
</div>

<style>
  .welle {
    position: relative;
    background: var(--von);
    height: clamp(44px, 6vw, 84px);
    margin-bottom: -1px;
    overflow: hidden;
    pointer-events: none;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  g {
    transform-box: fill-box;
  }
  .rueckwaerts {
    animation-direction: reverse;
  }
</style>
